# Copy to .env.local and fill in.

# Database (same value as packages/core/.env; Next.js doesn't read that file)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend. In development, OTP codes are also printed to the server console.
# Without a verified domain, use Resend's test sender below: it only delivers
# to the email address of your Resend account. With a verified domain, use
# e.g. "Billraklo <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM="Billraklo <onboarding@resend.dev>"

# WhatsApp
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=
APP_SECRET=
WABA_ID=

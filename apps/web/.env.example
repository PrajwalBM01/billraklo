# Copy this file to apps/web/.env.local.
# Next.js loads this file. Shared values are repeated to avoid relying on import order.

# Shared settings: keep these values consistent across packages/core/.env,
# apps/web/.env.local, and apps/worker/.env. All are server-side secrets.
# Required values are deliberately blank; fill them before starting the app.

# PostgreSQL connection string for the current PrismaNeon runtime adapter.
# Use a Neon database URL; an ordinary local PostgreSQL server is not a drop-in replacement.
DATABASE_URL=

# Redis for BullMQ. Both web and worker must use the same instance.
REDIS_URL=redis://127.0.0.1:6379

# Better Auth: generate a random secret of at least 32 characters.
# The worker must share this exact secret and URL with the web app.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google OAuth credentials (required by the current shared environment schema).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta / WhatsApp Business Platform.
# VERIFY_TOKEN is a verification string you choose and also enter in Meta's dashboard.
# APP_SECRET is the Meta app secret used to verify webhook signatures.
VERIFY_TOKEN=
APP_SECRET=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Actual bot WhatsApp number, including country code (digits only, e.g. 919876543210).
# Used in client invitation links; this is NOT the Meta PHONE_NUMBER_ID.
WHATSAPP_BOT_NUMBER=
# Select the Graph API version configured for your Meta app, including the v prefix.
GRAPH_API_VERSION=
# WhatsApp Business Account ID; currently validated even though not used by send calls.
WABA_ID=
# Optional legacy template settings. Client onboarding uses invitations and normal replies.
WHATSAPP_WELCOME_TEMPLATE=client_welcome
WHATSAPP_WELCOME_TEMPLATE_LANG=en

# Supabase Storage S3-compatible credentials. Create a private bucket first.
# Use the S3 endpoint, region, and S3 access keys from the project settings.
# These are NOT the Supabase anon key or service-role JWT.
SUPABASE_BUCKET=bills
SUPABASE_REGION=
SUPABASE_ENDPOINT=
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# Internal worker API, called by Next.js on the server (never NEXT_PUBLIC_*).
WORKER_API_URL=http://localhost:8787
# Generate a separate random secret. Must exactly match apps/worker/.env.
WORKER_API_SECRET=

# Email delivery. Optional for local development: verification codes are logged
# by the Next.js server when NODE_ENV is not production. Real delivery requires a key.
RESEND_API_KEY=
# For production, use a sender on your verified domain.
EMAIL_FROM="Billraklo <onboarding@resend.dev>"
